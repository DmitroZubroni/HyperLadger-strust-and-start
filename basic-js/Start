#!/usr/bin/env bash
# Запуск решения: сеть, контракт, API (порт 8091), интерфейс (порт 3005)
set -e
cd "$(dirname "$0")"
ROOT=$PWD

# Старый API держит порт и не даёт запуститься новому
if (exec 3<>/dev/tcp/127.0.0.1/8091) 2>/dev/null; then
  echo "Порт 8091 занят: возможно, запущен старый API. Остановите его и запустите снова."
  exit 1
fi

trap "kill 0" EXIT

cd ../fabric-samples/test-network
./network.sh down
./network.sh up createChannel -ca
./network.sh deployCC -ccn users -ccp "$ROOT/backend" -ccl javascript

# Пользователей API берёт из fabric-samples: администратор Admin@org1.example.com создаётся
# вместе с сетью, остальных создают в терминале, см. INSTRUCTION.md

cd "$ROOT/backend" && npm install
node api.js &
cd "$ROOT/front" && npm install && npx vite --host --port 3005
