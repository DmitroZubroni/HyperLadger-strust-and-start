#!/usr/bin/env bash
# Запуск решения: сеть, контракт, API (порт 8091), интерфейс (порт 3005)
set -e
cd "$(dirname "$0")"
ROOT=$PWD

# Старый API держит порт и не даёт запуститься новому
if (exec 3<>/dev/tcp/127.0.0.1/8091) 2>/dev/null; then
  echo "Порт 8091 занят: возможно, запущен старый API. Остановите его и запустите снова."
  exit 1
fi

trap "kill 0" EXIT

cd ../fabric-samples/test-network
./network.sh down
./network.sh up createChannel -ca
./network.sh deployCC -ccn users -ccp "$ROOT/backend" -ccl javascript

# Ключи администратора в wallet: пользователь admin из CA организации Org1.
# Остальных пользователей создают в терминале, см. INSTRUCTION.md
export PATH=$PWD/../bin:$PATH
export FABRIC_CA_CLIENT_HOME=$PWD/organizations/peerOrganizations/org1.example.com
rm -rf "$ROOT/wallet"
fabric-ca-client enroll -u https://admin:adminpw@localhost:7054 --caname ca-org1 \
  --tls.certfiles "$PWD/organizations/fabric-ca/org1/ca-cert.pem" -M "$ROOT/wallet/admin"

cd "$ROOT/backend" && npm install
node api.js &
cd "$ROOT/front" && npm install && npx vite --host --port 3005
